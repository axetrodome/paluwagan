{
  "expo": {
    "name": "paluwagan",
    "slug": "paluwagan",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "paluwagan",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.axetrodome.paluwagan"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.axetrodome.paluwagan"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "069b7879-d762-45e9-bb0e-3a4bdf74eb89"
      }
    },
    "owner": "axetrodomes-team"
  }
}
